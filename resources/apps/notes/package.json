{
  "name": "notes",
  "version": "0.1.0",
  "description": "Local-first notes with an infinite page tree — ProseMirror (Tiptap) + Yjs, edits sync live across every open device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "notes": "./bin/notes.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "vite build --config ui/vite.config.ts",
    "dev": "vite --config ui/vite.config.ts",
    "start": "node bin/notes.mjs start --foreground",
    "test": "node --no-warnings=ExperimentalWarning --test --test-force-exit --test-timeout=30000 \"test/*.test.mjs\"",
    "typecheck": "vue-tsc --noEmit -p ui/tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}

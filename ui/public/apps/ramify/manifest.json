{
    "id": "ramify",
    "name": "创意",
    "version": "0.2.0",
    "description": "创意发散画布:把一个想法发散成多个可预览、可比较的方案,分叉迭代、选优定稿。用户想「做几个方向」「对比几版」时用它。",
    "run": {
        "command": "node",
        "args": [
            "app/dist/server.mjs"
        ],
        "health": "/api/health",
        "mode": "on-demand"
    },
    "permissions": [
        "ai.agent"
    ]
}

{
  "name": "board",
  "version": "0.1.0",
  "description": "A local-first project board. Cards side by side, items inside, details one tap away — driven by an AI agent through a CLI, read on your phone.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "board": "./bin/board.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "vite build --config ui/vite.config.ts",
    "dev": "vite --config ui/vite.config.ts",
    "start": "node bin/board.mjs start --foreground",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}

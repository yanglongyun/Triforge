{
    "id": "mindmap",
    "name": "导图",
    "version": "1.0.0",
    "description": "思维导图,画布与大纲两种视图。用户说「整理成导图」「画个脑图」,或要把层级化的想法可视化时用它。",
    "run": {
        "command": "node",
        "args": [
            "scripts/mindmap.mjs",
            "_serve"
        ],
        "health": "/health",
        "mode": "on-demand"
    },
    "permissions": []
}

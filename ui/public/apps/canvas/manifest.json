{
    "id": "canvas",
    "name": "画布",
    "version": "0.1.0",
    "description": "本地无限画布,基于 Excalidraw,可建多张场景并多端实时同步。用户说「画」「画个图」「画布」「白板」「架构图」时用它;agent 能建场景、改名、删除、读取画布里的文字和元素构成,但不能代画。",
    "run": {
        "command": "node",
        "args": [
            "bin/canvas.mjs",
            "start",
            "--foreground"
        ],
        "health": "/health",
        "mode": "on-demand"
    },
    "permissions": []
}

{
  "name": "notes",
  "version": "0.1.0",
  "description": "Local-first notes with an infinite page tree — ProseMirror (Tiptap) + Yjs, edits sync live across every open device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "notes": "./bin/notes.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "vite build --config ui/vite.config.ts",
    "dev": "vite --config ui/vite.config.ts",
    "start": "node bin/notes.mjs start --foreground",
    "test": "node --no-warnings=ExperimentalWarning --test --test-force-exit --test-timeout=30000 \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "lib0": "^0.2.117",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-collaboration": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-task-item": "^3.30.3",
    "@tiptap/extension-task-list": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/suggestion": "^3.30.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.1.0"
  }
}
